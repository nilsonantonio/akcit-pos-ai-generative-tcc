FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    build-essential \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY requirements-macos-mps.txt /tmp/requirements-macos-mps.txt
RUN pip install --no-cache-dir -r /tmp/requirements-macos-mps.txt

CMD ["bash"]
